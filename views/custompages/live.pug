extends ../layout.pug

//- XDTV: ekran zastępczy do Etapu 3 (moduł streamerów).

block head
	title LIVE — #{meta.siteName}
	meta(name='robots' content='noindex')

block content
	.xdtv-home
		header.xdtv-hero
			h1.xdtv-hero-title 🔴 Teraz LIVE
			p.xdtv-hero-sub Wkrótce. Kto teraz nadaje: Twitch, Kick, YouTube — miniatura, tytuł, widzowie, OGLĄDAJ.
		p.xdtv-empty
			| Na razie zajrzyj na 
			a(href='/stream/index.html') /stream/
			|  — tam lądują klipy i akcje z live'ów.
