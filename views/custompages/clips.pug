extends ../layout.pug

//- XDTV: ekran zastępczy do Etapu 3 (moduł streamerów).

block head
	title Klipy — #{meta.siteName}
	meta(name='robots' content='noindex')

block content
	.xdtv-home
		header.xdtv-hero
			h1.xdtv-hero-title 🎬 Klipy
			p.xdtv-hero-sub Wkrótce. Klipy streamerów z Twitcha, Kicka i YouTube'a — siatka, dużo obrazków, mało tekstu.
		p.xdtv-empty
			| Na razie zajrzyj na 
			a(href='/stream/index.html') /stream/
			|  — tam lądują klipy i akcje z live'ów.
