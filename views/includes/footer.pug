//- XDTV: Regulamin · FAQ · Kod źródłowy. Link do kodu wymaga AGPLv3 (§13) —
//- Repo musi zawierać kod wersji, która działa na serwerze (zob. deploy/README).
- const xdtvSourceUrl = 'https://github.com/V-SGFX/xdtv2'
unless minimal
	small.footer#bottom.xdtv-footer
		a(href='/rules.html') Regulamin
		| #{' · '}
		a(href='/faq.html') FAQ
		| #{' · '}
		a(href=xdtvSourceUrl rel='noopener') Kod źródłowy (AGPLv3)
		div.xdtv-footer-sub
			| XDTV.FANS — oparte na jschan/mchan #{version}

//- "render" script - for scripted things that are blocking
script(src=`/js/render.js?v=${commit}`)
