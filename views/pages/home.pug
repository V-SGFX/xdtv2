extends ../layout.pug

//- XDTV: strona główna — content first. Dane: lib/xdtv/home.js (buildHomepage).

mixin xdtvThumb(file, cls)
	- const base = (file.cdn && cdnUrl) ? `${cdnUrl}/${file.cdn}/` : '/file/'
	- const src = file.hasThumb ? `${base}thumb/${file.hash}${file.thumbextension}` : `${base}${file.filename}`
	- const isVideo = file.mimetype && file.mimetype.startsWith('video/')
	- const isGif = file.mimetype === 'image/gif'
	span(class=cls)
		img(src=src alt='' loading='lazy' decoding='async')
		if isVideo
			span.xdtv-badge ▶
		else if isGif
			span.xdtv-badge GIF

mixin xdtvSnippet(post, len)
	if post.subject
		b #{post.subject.substring(0, 60)}#{post.subject.length > 60 ? '…' : ''}
		if post.nomarkup
			| #{' — '}
	if post.nomarkup
		| #{post.nomarkup.substring(0, len)}#{post.nomarkup.length > len ? '…' : ''}
	if !post.nomarkup && !post.subject
		span.xdtv-muted >>>/#{post.board}/#{post.postId}

block head
	title #{meta.siteName} — Co dziś wygrzebał internet?
	meta(name='description' content='XDTV.FANS — internetowy śmietnik: memy, obrazki, GIF-y, klipy streamerów i LIVE.')
	meta(property='og:title' content=`${meta.siteName} — Co dziś wygrzebał internet?`)
	meta(property='og:description' content='Memy, obrazki, GIF-y, klipy streamerów i LIVE.')
	if meta.url
		link(rel='canonical' href=`${meta.url}/`)
		meta(property='og:url' content=`${meta.url}/`)

block content
	.xdtv-home
		header.xdtv-hero
			h1.xdtv-hero-title Co dziś wygrzebał internet?
			p.xdtv-hero-sub Memy, obrazki, GIF-y, klipy streamerów. Wrzucasz bez konta.

		section.xdtv-section
			h2.xdtv-h 🔥 Najnowsze
			if latestImages && latestImages.length > 0
				.xdtv-grid
					each item in latestImages
						a.xdtv-tile(href=item.link title=`/${item.post.board}/`)
							+xdtvThumb(item.file, 'xdtv-tile-img')
							span.xdtv-tile-board /#{item.post.board}/
			else
				p.xdtv-empty Pusto. Bądź pierwszy — wrzuć coś na
					| #{' '}
					a(href='/smietnik/index.html') /smietnik/
					| .

		.xdtv-cols
			section.xdtv-section.xdtv-col-main
				h2.xdtv-h 💩 Najnowsze wrzuty
				if latestPosts && latestPosts.length > 0
					ul.xdtv-list
						each item in latestPosts
							li.xdtv-row
								a.xdtv-row-link(href=item.link)
									if item.file
										+xdtvThumb(item.file, 'xdtv-row-thumb')
									else
										span.xdtv-row-thumb.xdtv-row-nothumb ¶
									span.xdtv-row-body
										span.xdtv-row-meta
											span.xdtv-tag /#{item.post.board}/
											| #{' · '}
											- const d = new Date(item.post.date)
											time.reltime(datetime=d.toISOString()) #{d.toLocaleString(pageLanguage, {hourCycle:'h23'})}
										span.xdtv-row-text
											+xdtvSnippet(item.post, 120)
				else
					p.xdtv-empty Jeszcze nic. Internet się rozgrzewa.

			aside.xdtv-col-side
				section.xdtv-section
					h2.xdtv-h 🔥 HOT
					if hotThreads && hotThreads.length > 0
						ul.xdtv-list
							each item in hotThreads
								li.xdtv-row
									a.xdtv-row-link(href=item.link)
										if item.file
											+xdtvThumb(item.file, 'xdtv-row-thumb')
										else
											span.xdtv-row-thumb.xdtv-row-nothumb 🔥
										span.xdtv-row-body
											span.xdtv-row-meta
												span.xdtv-tag /#{item.post.board}/
												| #{' · '}#{item.post.replyposts} odp.
											span.xdtv-row-text
												+xdtvSnippet(item.post, 70)
					else
						p.xdtv-empty Nic się jeszcze nie pali.

				section.xdtv-section
					h2.xdtv-h Boardy
					if boards && boards.length > 0
						ul.xdtv-boards
							each b in boards
								li
									a(href=`/${b._id}/index.html`)
										span.xdtv-tag /#{b._id}/
										|  #{b.settings.name}
									if b.settings.description
										span.xdtv-board-desc #{b.settings.description}
