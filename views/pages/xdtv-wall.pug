extends ../layout.pug
include ../mixins/xdtv.pug

//- XDTV — ściana: Najnowsze (index), Popularne, Dziś. Dane: lib/xdtv/home.js
//- Kolejne porcje (Najnowsze) doładowuje xdtv-wall.js z /xdtv/sciana.html.

block head
	- const pageTitle = wallTab === 'najnowsze' ? `${meta.siteName} — ściana internetowych śmieci` : `${wallTitle} — ${meta.siteName}`
	- const pagePath = wallTab === 'najnowsze' ? '/' : `/${wallTab}.html`
	title #{pageTitle}
	meta(name='description' content='Ściana memów, obrazków, GIF-ów i screenów. Wrzucasz bez konta. Do tego LIVE i klipy streamerów.')
	meta(property='og:title' content=pageTitle)
	meta(property='og:description' content='Memy, obrazki, GIF-y, screeny, LIVE i klipy streamerów.')
	if meta.url
		link(rel='canonical' href=`${meta.url}${pagePath}`)
		meta(property='og:url' content=`${meta.url}${pagePath}`)
	if wallItems && wallItems[0]
		- const f = wallItems[0].file
		meta(property='og:image' content=`${(f.cdn && cdnUrl) ? `${cdnUrl}/${f.cdn}/` : (meta.url || '') + '/file/'}${f.hasThumb ? 'thumb/' + f.hash + f.thumbextension : f.filename}`)

block content
	.xdtv-page
		.xdtv-main
			if featured && featured.length >= 3
				section.xdtv-featured(aria-label='Na topie')
					each item, i in featured
						+xdtvTile(item, i === 0 ? 'xdtv-tile-big' : 'xdtv-tile-small')

			.xdtv-section-head
				h1.xdtv-section-title #{wallTitle}
				span.xdtv-section-note
					case wallTab
						when 'popularne'
							| najwięcej reakcji i komentarzy z ostatnich 7 dni
						when 'dzis'
							| co się dzieje od wczoraj
						default
							| świeże wrzuty ze wszystkich kanałów

			if wallItems && wallItems.length > 0
				.xdtv-wall
					each item in wallItems
						+xdtvTile(item)
				if wallNext
					.xdtv-more(data-xdtv-more=`/xdtv/sciana.html?przed=${wallNext}`)
						span.xdtv-more-spinner Ładuję kolejne…
			else
				.xdtv-empty
					p Pusto. Bądź pierwszy.
					a.xdtv-btn(href='#wrzuc' data-xdtv-upload) + Wrzuć

		include ../includes/xdtv-sidebar.pug
