//- XDTV — wspólne elementy ściany: kafelek, reakcje, karty LIVE i klipów.

//- Stałe trzymamy w mixinach: pug nie pozwala na kod na najwyższym poziomie
//- pliku dołączanego do szablonu, który rozszerza layout.

mixin xdtvThumbSrc(file)
	- const base = (file.cdn && cdnUrl) ? `${cdnUrl}/${file.cdn}/` : '/file/'
	| #{file.hasThumb ? `${base}thumb/${file.hash}${file.thumbextension}` : `${base}${file.filename}`}

mixin xdtvMedia(file, cls)
	- const base = (file.cdn && cdnUrl) ? `${cdnUrl}/${file.cdn}/` : '/file/'
	- const src = file.hasThumb ? `${base}thumb/${file.hash}${file.thumbextension}` : `${base}${file.filename}`
	- const isVideo = file.mimetype && file.mimetype.startsWith('video/')
	- const isGif = file.mimetype === 'image/gif'
	span(class=cls)
		img(src=src alt='' loading='lazy' decoding='async')
		if isVideo
			span.xdtv-badge.xdtv-badge-play ▶
		else if isGif
			span.xdtv-badge GIF

//- Liczniki pod kafelkiem: dwie najczęstsze reakcje + komentarze. data-ref → odświeżane przez JS.
mixin xdtvTileMeta(item)
	- const xdtvReactionEmoji = { smiech: '😂', ogien: '🔥', czaszka: '💀', klaun: '🤡', serce: '❤️' }
	span.xdtv-tile-meta(data-ref=`${item.post.board}:${item.post.postId}`)
		span.xdtv-tile-reacts
			each r in item.reactions
				span.xdtv-react-mini #{xdtvReactionEmoji[r[0]]} #{r[1]}
		span.xdtv-tile-comments 💬 #{item.replies}
		span.xdtv-tile-board #{item.post.board}

mixin xdtvTile(item, cls)
	a.xdtv-tile(href=item.link class=cls style=`--r:${item.ratio.toFixed(3)}` title=(item.post.subject || item.post.nomarkup || '').substring(0, 120))
		+xdtvMedia(item.file, 'xdtv-tile-media')
		+xdtvTileMeta(item)

//- Pasek reakcji pod postem (widok wątku). Przyciski działają przez JS (xdtv.js).
mixin xdtvReactBar(post)
	- const xdtvReactionEmoji = { smiech: '😂', ogien: '🔥', czaszka: '💀', klaun: '🤡', serce: '❤️' }
	- const counts = post.xdtvReactions || {}
	.xdtv-reactbar(data-ref=`${post.board}:${post.postId}` data-board=post.board data-post=post.postId)
		each emoji, kind in xdtvReactionEmoji
			button.xdtv-react(type='button' data-kind=kind title='Reaguj')
				span.xdtv-react-emoji #{emoji}
				span.xdtv-react-count #{counts[kind] > 0 ? counts[kind] : ''}

mixin xdtvLiveCard(c, compact)
	- const xdtvPlatformName = { twitch: 'Twitch', kick: 'Kick', youtube: 'YouTube' }
	a.xdtv-live-card(href=c.platformUrl target='_blank' rel='noopener nofollow' class=(compact ? 'xdtv-live-compact' : ''))
		span.xdtv-live-thumb
			if c.thumbnailUrl
				img(src=c.thumbnailUrl alt='' loading='lazy' decoding='async')
			span.xdtv-live-badge LIVE
			span.xdtv-live-viewers #{(c.viewerCount || 0).toLocaleString('pl-PL')} widzów
		span.xdtv-live-body
			span.xdtv-live-name
				| #{c.displayName}
				span.xdtv-platform(class=`xdtv-platform-${c.platform}`) #{xdtvPlatformName[c.platform] || c.platform}
			if c.currentTitle
				span.xdtv-live-title #{c.currentTitle}
			if c.category
				span.xdtv-live-cat #{c.category}
			unless compact
				span.xdtv-btn.xdtv-btn-small Oglądaj

mixin xdtvClipCard(c)
	- const xdtvPlatformName = { twitch: 'Twitch', kick: 'Kick', youtube: 'YouTube' }
	a.xdtv-clip-card(href=c.url target='_blank' rel='noopener nofollow')
		span.xdtv-clip-thumb
			if c.thumbnailUrl
				img(src=c.thumbnailUrl alt='' loading='lazy' decoding='async')
			if c.duration
				span.xdtv-clip-dur #{Math.floor(c.duration / 60)}:#{String(Math.round(c.duration % 60)).padStart(2, '0')}
			span.xdtv-badge.xdtv-badge-play ▶
		span.xdtv-clip-body
			span.xdtv-clip-title #{c.title}
			span.xdtv-clip-meta
				| #{c.creatorName}
				span.xdtv-platform(class=`xdtv-platform-${c.platform}`) #{xdtvPlatformName[c.platform] || c.platform}
				if c.views
					|  · #{c.views.toLocaleString('pl-PL')} wyśw.
